# OpenClaw state root. Defaults to $HOME/.openclaw.
OPENCLAW_STATE_DIR=/home/your-user/.openclaw

# Shared result root written by your n8n image/video workflows.
OPENCLAW_ASSET_SHARED_ROOT=/path/to/n8n/openclaw-assets

# Path used inside the n8n container for the same mounted directory.
N8N_ASSET_ROOT=/data/openclaw-assets
OPENCLAW_ASSET_CALLBACK_URL=http://openclaw-gateway:18789/hooks/deepwhite-assets

# Optional webhook URLs. Configure these in the OpenClaw/NAS runtime, never commit secrets.
N8N_ASSET_WEBHOOK_URL=https://n8n.example.com/webhook/assets
N8N_ASSET_WEBHOOK_SECRET=replace-me
N8N_VIDEO_WEBHOOK_URL=https://n8n.example.com/webhook/video
N8N_VIDEO_WEBHOOK_SECRET=replace-me

