{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepwhite.local/schemas/expanded-asset-list.schema.json",
  "title": "DeepWhite Expanded Asset List",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "pass",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "pass": {
      "enum": [
        "BASE_ASSET",
        "SHOT_ASSET_GAP"
      ]
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "required": [
        "asset_id",
        "role",
        "required",
        "approved_only"
      ],
      "properties": {
        "asset_id": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "approved_only": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "asset": {
      "type": "object",
      "required": [
        "asset_id",
        "parent_asset_id",
        "family_id",
        "style_id",
        "asset_code",
        "category",
        "name",
        "aspect_ratio",
        "generation_stage",
        "lock_id",
        "lock_hash",
        "depends_on",
        "reference_inputs",
        "prompt_zh",
        "filename",
        "status"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "parent_asset_id": {
          "type": "string"
        },
        "family_id": {
          "type": "string"
        },
        "style_id": {
          "type": "string"
        },
        "asset_code": {
          "type": "string"
        },
        "category": {
          "enum": [
            "character",
            "location",
            "animal",
            "creature",
            "prop",
            "style",
            "storyboard",
            "other"
          ]
        },
        "name": {
          "type": "string"
        },
        "aspect_ratio": {
          "enum": [
            "1:1",
            "2:3",
            "3:2",
            "3:4",
            "4:3",
            "4:5",
            "5:4",
            "9:16",
            "16:9",
            "21:9"
          ]
        },
        "generation_stage": {
          "enum": [
            "anchor",
            "derived",
            "shot"
          ]
        },
        "lock_id": {
          "type": "string"
        },
        "lock_hash": {
          "type": "string"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reference_inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "anchor_roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prompt_zh": {
          "type": "string"
        },
        "prompt_en": {
          "type": "string"
        },
        "negative_prompt": {
          "type": "string"
        },
        "filename": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+\\.png$"
        },
        "status": {
          "enum": [
            "planned",
            "blocked_by_dependency",
            "ready",
            "submitted",
            "generated",
            "approved",
            "failed",
            "rejected",
            "superseded"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}