{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepwhite.local/schemas/asset-job-v2.schema.json",
  "title": "DeepWhite Continuity Asset Job v2.1",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "job_id",
    "source",
    "defaults",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^2\\."
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "source": {
      "type": "string"
    },
    "defaults": {
      "type": "object",
      "required": [
        "model",
        "image_size",
        "review_model",
        "review_min_score",
        "review_max_retries"
      ],
      "properties": {
        "model": {
          "type": "string"
        },
        "image_size": {
          "type": "string"
        },
        "review_model": {
          "type": "string"
        },
        "review_min_score": {
          "type": "number"
        },
        "review_max_retries": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://deepwhite.local/schemas/expanded-asset-list.schema.json#/$defs/asset"
      }
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "not": {
    "required": ["shared_asset_root"]
  },
  "additionalProperties": true
}
