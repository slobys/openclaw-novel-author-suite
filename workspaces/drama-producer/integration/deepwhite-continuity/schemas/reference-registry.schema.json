{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepwhite.local/schemas/reference-registry.schema.json",
  "title": "DeepWhite Reference Registry",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "updated_at",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "asset_id",
          "status",
          "filename",
          "path",
          "job_id",
          "payload_sha256",
          "lock_hash",
          "sha256",
          "file_size"
        ],
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "generated",
              "approved",
              "rejected",
              "failed",
              "superseded"
            ]
          },
          "filename": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "job_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "payload_sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "lock_hash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "file_size": {
            "type": "integer",
            "minimum": 0
          },
          "mime_type": {
            "type": "string"
          },
          "qa_score": {
            "type": "number"
          },
          "anchor_roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "approved_version": {
            "type": "string"
          },
          "generated_at": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
