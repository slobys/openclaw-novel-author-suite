{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepwhite.local/schemas/reference-registry.schema.json",
  "title": "DeepWhite Reference Registry",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "updated_at",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "asset_id",
          "status",
          "filename",
          "path"
        ],
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "generated",
              "approved",
              "rejected",
              "failed",
              "superseded"
            ]
          },
          "filename": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "mime_type": {
            "type": "string"
          },
          "qa_score": {
            "type": "number"
          },
          "anchor_roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "approved_version": {
            "type": "string"
          },
          "generated_at": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}