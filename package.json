{
  "name": "@slobys/openclaw-novel-engine",
  "version": "0.6.0",
  "description": "Novel Engine 0.6.0: Balanced-Fast cached role packets and scoped integrity on top of the proven recoverable chapter finalizer.",
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "src",
    "scripts",
    "test",
    "skills",
    "openclaw.plugin.json",
    "README.md",
    "UPGRADE-0.4.10.md",
    "UPGRADE-0.5.0.md",
    "UPGRADE-0.6.0.md",
    "AUDIT-REPORT.md"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check-package.js",
    "verify": "npm run build && npm test && npm run check",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "typebox": "^1.1.39"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.5.17",
      "minGatewayVersion": "2026.5.17"
    },
    "build": {
      "openclawVersion": "2026.7.1",
      "pluginSdkVersion": "2026.7.1"
    }
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "novelEngine": {
    "schemaVersion": "2",
    "agentCompatibility": ">=5.4.3",
    "capabilities": [
      "balanced_fast_role_packets",
      "chapter_cas",
      "chapter_scoped_integrity",
      "request_id_idempotency",
      "recoverable_finalize",
      "closure_ledger",
      "independent_quality_gate",
      "canonical_body_hash",
      "project_integrity_check"
    ]
  }
}
