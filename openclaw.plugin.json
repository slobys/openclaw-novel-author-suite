  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "projectsRoot": {
        "type": "string",
        "minLength": 1,
        "description": "Absolute persistent directory for novel projects; defaults to ~/.openclaw/data/novels."
      },
      "importRoots": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "description": "Absolute directories from which TXT references may be imported."
      },
      "maxReferenceBytes": {
        "type": "integer",
        "minimum": 1024,
        "maximum": 104857600,
        "default": 20971520
      },
      "referenceChunkChars": {
        "type": "integer",
        "minimum": 2000,
        "maximum": 40000,
        "default": 12000
      },
      "minChapterChars": {
        "type": "integer",
        "minimum": 100,
        "maximum": 10000,
        "default": 800
      },
      "minChapterHanChars": {
        "type": "integer",
        "minimum": 0,
        "maximum": 20000,
        "default": 2000
      },
      "targetChapterHanChars": {
        "type": "integer",
        "minimum": 0,
        "maximum": 30000,
        "default": 2600
      },
      "targetChapterHanCharsMax": {
        "type": "integer",
        "minimum": 0,
        "maximum": 50000,
        "default": 3200
      },
      "requireChapterAudit": {
        "type": "boolean",
        "default": true
      },
      "requireCompleteAuditChecks": {
        "type": "boolean",
        "default": true
      },
      "requireQualityGate": {
        "type": "boolean",
        "default": true
      },
      "requireRevisionAudit": {
        "type": "boolean",
        "default": true
      },
      "requireRevisionCas": {
        "type": "boolean",
        "default": true
      },
      "requireClosureReceipt": {
        "type": "boolean",
        "default": true
      },
      "rejectEmbeddedChapterHeading": {
        "type": "boolean",
        "default": true
      },
      "lockStaleMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 86400000,
        "default": 600000
      },
      "lockAcquireTimeoutMs": {
        "type": "integer",
        "minimum": 0,
        "maximum": 120000,
        "default": 15000
      },
      "maxArtifactChars": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 5000000,
        "default": 500000
      },
      "maxContinuityDeltaChars": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 2000000,
        "default": 200000
      },
      "maxMemoryRecords": {
        "type": "integer",
        "minimum": 100,
        "maximum": 100000,
        "default": 10000
      },
      "maxLedgerEntries": {
        "type": "integer",
        "minimum": 100,
        "maximum": 100000,
        "default": 10000
      },
      "transactionRetention": {
        "type": "integer",
        "minimum": 10,
        "maximum": 10000,
        "default": 200
      }
    }
  }
}
